{
  "name": "open-source-contribution-journal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "dev:e2e": "node scripts/dev-e2e.mjs",
    "build": "npm run build --workspace apps/web",
    "start": "npm run start --workspace apps/web",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "tsc --noEmit -p apps/web/tsconfig.json",
    "seed": "node scripts/seed-fixture.mjs",
    "e2e": "node scripts/seed-fixture.mjs && node scripts/e2e.mjs",
    "a11y": "node scripts/seed-fixture.mjs && node scripts/a11y.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "playwright": "^1.62.1"
  },
  "description": "Turn GitHub pull requests and issues into visual, evidence-linked stories of what you learned building them.",
  "repository": {
    "type": "git",
    "url": "https://github.com/hugosmoreira/contribution-journal.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  }
}
