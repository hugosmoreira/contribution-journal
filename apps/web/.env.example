# Copy to .env.local and fill in what you need:
#   cp apps/web/.env.example apps/web/.env.local
# Everything here is optional except DATABASE_URL, which publishing needs.
# .env.local is gitignored — never commit real values.

# --- Database (required for publishing and sign-in) ---
# Matches docker-compose.yml at the repo root: `docker compose up -d`.
DATABASE_URL=postgres://journal:journal_dev@localhost:5544/journal

# --- GitHub import ---
# Anonymous imports are limited to 60 requests/hour by GitHub. A read-only
# personal access token (no scopes needed for public repos) raises it to 5,000.
GITHUB_TOKEN=

# --- AI drafting ---
# Without a key the maps are still generated, but from evidence alone — the
# supported "null adapter" mode, not a degraded one. Get a key at
# https://platform.claude.com/ . Verify it with:
#   npm run test:live -w packages/ai
ANTHROPIC_API_KEY=
# JOURNAL_AI_MODEL=claude-opus-5
# Alternative provider: DeepSeek (chat-completions API, JSON mode). Same
# prompts, same evidence rules, same visible-AI labeling.
# DEEPSEEK_API_KEY=
# JOURNAL_DEEPSEEK_MODEL=deepseek-v4-flash
# Picks the provider when both keys are set: anthropic (default) | deepseek
# JOURNAL_AI_PROVIDER=
# Pins the null adapter even when a key is set (used by `npm run dev:e2e`).
# JOURNAL_DISABLE_AI=1

# --- GitHub OAuth sign-in ---
# Create an OAuth App: github.com -> Settings -> Developer settings -> OAuth Apps
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback
# Sign-in requests no scopes at all: read-only public access, no write access.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# 32+ characters. Enables AES-256-GCM encryption of stored GitHub access
# tokens. Without it sign-in works identically — tokens are simply never stored.
JOURNAL_SECRET=

# --- Agent capture (packages/mcp) ---
# 24+ characters. Shared secret between the app and the MCP server your coding
# agent connects to. This is machine auth, not user auth.
JOURNAL_API_TOKEN=

# --- Serverless hosting (Netlify/Vercel) ---
# Project dirs are read-only on serverless hosts; point the file caches
# (imports, AI drafts, agent notes) at a writable path. On Netlify set:
#   JOURNAL_CACHE_DIR=/tmp/journal-cache
# JOURNAL_CACHE_DIR=

# --- Operations (optional) ---
# Salt for the hashed IP/account keys used by quotas and metrics. Set this in
# production; the built-in development fallback is public in the source.
METRICS_SALT=
# Lets the deployment owner unpublish any story (abuse takedowns).
JOURNAL_ADMIN_TOKEN=
# Global published-row circuit breaker (default 10000).
JOURNAL_MAX_PUBLISHED_ROWS=
# Pin the public origin when running behind a proxy.
JOURNAL_BASE_URL=
